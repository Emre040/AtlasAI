# Runtime
NODE_ENV=production
HPA_APP_NAME=AtlasAI
HPA_HOST=127.0.0.1
HPA_PORT=9000
TRUST_PROXY=loopback
HPA_JSON_LIMIT=2mb
HPA_CORS_ORIGINS=https://example-frontend.invalid

# Provider credentials selected by inference_providers.credential_env_key
OPENAI_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ALIBABA_API_KEY=
DEEPSEEK_API_KEY=

# Database
HPA_DB_HOST=127.0.0.1
HPA_DB_USER=
HPA_DB_PASS=
HPA_DB_NAME=atlasai
HPA_DB_CONN=20

# Authentication and request controls
HPA_BATCH_SECRET=
ATLAS_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
ATLAS_GLOBAL_RATE_LIMIT_MAX=300
ATLAS_DEPLOY_WEBHOOK_SECRET_FILE=/absolute/path/to/deploy-webhook.secret
# 32 random bytes as lowercase hex in a mode 0600 file; encrypts visitor provider keys at rest
ATLAS_PROVIDER_KEY_SECRET_FILE=/absolute/path/to/provider-keys.secret
ATLAS_DEPLOY_GITHUB_REPOSITORY=Emre040/AtlasAI
ATLAS_DEPLOY_REPOSITORY_ROOT=/absolute/path/to/AtlasAI
ATLAS_CLOUDFLARE_ENRICHED_HEADERS=false
ATLAS_CLOUDFLARE_METADATA_SECRET=
ATLAS_AUTH_ACCESS_TTL_MS=900000
ATLAS_AUTH_IDLE_TTL_MS=2592000000
ATLAS_AUTH_ABSOLUTE_TTL_MS=15552000000
ATLAS_AUTH_ACCESS_COOKIE_NAME=__Secure-atlas_access
ATLAS_AUTH_ACCESS_COOKIE_PATH=/
ATLAS_AUTH_REFRESH_COOKIE_NAME=__Secure-atlas_refresh
ATLAS_AUTH_REFRESH_COOKIE_PATH=/auth
ATLAS_AUTH_COOKIE_SECURE=true
ATLAS_AUTH_COOKIE_SAME_SITE=none
ATLAS_AUTH_COOKIE_PARTITIONED=true

# Local data
HPA_ASO_WORKSPACES_DIR=./runtime/workspaces
HPM_SUMMARIES_PATH=./data/hpm_summaries.json

# Diagnostics
HPA_SSE_DEBUG=false
HPA_LOG_LLM_IO=false
HPA_ASO_LOG_TOOL_STEPS=false
ATLAS_VERBOSE_DIAGNOSTICS=false
