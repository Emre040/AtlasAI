# Copy to config.env and fill in. Never commit config.env (it's gitignored).

# ============================================================
# REQUIRED
# ============================================================

# LLM model name passed to the provider. Recommended: gpt-4.1-mini-2025-04-14.
HPA_MODEL="gpt-4.1-mini-2025-04-14"

# LLM provider: openai | gemini | anthropic | openrouter. Recommended: openai.
LLM_PROVIDER="openai"

# Set the key matching your LLM_PROVIDER above
OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENROUTER_API_KEY=""

# MySQL table names. The defaults below are what the schema expects — only
# change them if you've renamed the tables in your database. They must be set
# even when running on the in-memory fallback (the SQL strings reference them).
HPA_TBL_COOKIES="hpa_cookies"                # tracks anonymous visitor sessions (cookie id, IP, UA, block flags)
HPA_TBL_CONVERSATIONS="hpa_conversations"    # one row per chat thread
HPA_TBL_MESSAGES="hpa_messages"              # individual user / AI messages within a conversation

# Comma-separated list of allowed origins for browser CORS.
# For local dev, include the frontend URL.
HPA_CORS_ORIGINS="http://localhost:8010"

# ============================================================
# RECOMMENDED — MySQL persistence
# If any of these 5 are missing, the server falls back to an in-memory store
# (data is lost on restart — fine for smoke tests, not for real use).
# ============================================================
HPA_DB_HOST="localhost"
HPA_DB_USER=""
HPA_DB_PASS=""
HPA_DB_NAME="webserver_hpa"
HPA_DB_CONN=20

# ============================================================
# OPTIONAL — server tuning (sane defaults if omitted)
# ============================================================
HPA_PORT=8012                          # default 9012
HPA_APP_NAME="HPAAgent"                # cosmetic, surfaced in /healthz
NODE_ENV="development"                 # set to "production" to suppress stack traces
TRUST_PROXY="false"                    # "true" if behind a reverse proxy
HPA_JSON_LIMIT="2mb"                   # express.json body limit
HPA_QUERY_RATE_LIMIT_WINDOW_MS=120000  # default 120000
HPA_QUERY_RATE_LIMIT_MAX=30            # default 30
HPA_BLOCKLIST_REFRESH_MS=10000         # default 10000
# HPA_ASO_WORKSPACES_DIR=""            # defaults to Backend/workspaces

# ============================================================
# OPTIONAL — feature-specific (only set if using the feature)
# ============================================================

# Admin analytics routes (/hpa-admin/*)
HPA_ADMIN_USERNAME=""
HPA_ADMIN_PASSWORD=""

# Batch query API (/batch/*)
HPA_BATCH_SECRET=""

# ============================================================
# OPTIONAL — overrides for the LLM client
# ============================================================
# LLM_API_KEY=""    # takes priority over the provider's keyEnv above
# LLM_BASE_URL=""   # takes priority over the provider preset

# ============================================================
# OPTIONAL — debug / dev flags
# ============================================================
# HPA_FORCE_MEMORY="true"        # force in-memory DB even if MySQL env is set
# HPA_SSE_DEBUG="true"           # verbose SSE logs
# HPA_LOG_LLM_IO="1"             # dump LLM request/response payloads
# HPA_ASO_LOG_TOOL_STEPS="true"  # log every ASO tool step
