  {
   "turn": 8,
   "name": "sql",
   "input": {
    "query": "WITH t AS (\n SELECT\n  LOG10(TRY_CAST(\"Blood concentration - Conc. blood IM [pg/L]\" AS DOUBLE)) AS x,\n  LOG10(TRY_CAST(\"Blood concentration - Conc. blood MS [pg/L]\" AS DOUBLE)) AS y\n FROM proteinatlas\n WHERE TRY_CAST(\"Blood concentration - Conc. blood IM [pg/L]\" AS DOUBLE) > 0\n   AND TRY_CAST(\"Blood concentration - Conc. blood MS [pg/L]\" AS DOUBLE) > 0\n)\nSELECT COUNT(*) AS n,\n       ROUND(AVG(x),4) AS mean_log10_im,\n       ROUND(AVG(y),4) AS mean_log10_ms,\n       ROUND(AVG(x-y),4) AS mean_log10_ratio_im_over_ms,\n       ROUND((SUM((x-avgx)*(y-avgy)))/(SQRT(SUM((x-avgx)^2)*SUM((y-avgy)^2))),4) AS pearson_r,\n       ROUND(MIN(x-y),4) AS min_ratio,\n       ROUND(MAX(x-y),4) AS max_ratio\nFROM (SELECT x,y,AVG(x) OVER () AS avgx, AVG(y) OVER () AS avgy FROM t)"
   },
