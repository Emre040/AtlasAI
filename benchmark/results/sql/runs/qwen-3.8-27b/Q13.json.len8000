     "name": "sql",
     "input": "{\"query\": \"SELECT \\\"Cancer\\\", \\\"Organ\\\", \\\"Num samples\\\" FROM cancer_rna_tcga_cancers WHERE Cancer IN ('Liver Hepatocellular Carcinoma','Kidney Renal Clear Cell Carcinoma','Pancreatic Adenocarcinoma')\"}"
    },
    {
     "name": "sql",
     "input": "{\"query\": \"WITH c AS (\\n  SELECT \\\"Gene\\\",\\n         split_part(\\\"Protein tissue specific Intensity\\\", ':', 1) AS tissue\\n  FROM proteinatlas\\n  WHERE \\\"Protein tissue specificity\\\" = 'Tissue enriched'\\n    AND split_part(\\\"Protein tissue specific Intensity\\\", ':', 1) IN ('liver','kidney','pancreas')\\n)\\nSELECT \\\"Gene\\\", count(*) AS n_rows, string_agg(DISTINCT tissue, ', ') AS tissues\\nFROM c GROUP BY 1 HAVING count(DISTINCT tissue) > 1\"}"
    }
   ]
