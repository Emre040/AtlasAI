    "query": "WITH org AS (\n  SELECT \"Gene\", \"Protein tissue specific Intensity\",\n         split_part(\"Protein tissue specific Intensity\", ':', 1) AS tissue\n  FROM proteinatlas\n  WHERE \"Protein tissue specificity\" = 'Tissue enriched'\n    AND \"Protein tissue distribution\" = 'Detected in single'\n)\nSELECT tissue, count(*) AS n, sum(CASE WHEN TRY_CAST(regexp_extract(\"Protein tissue specific Intensity\", '([0-9.]+)$', 1) AS DOUBLE) IS NOT NULL THEN 1 ELSE 0 END) AS cnt_parse\nFROM org GROUP BY tissue\nHAVING count(*) > 50 ORDER BY n DESC"
