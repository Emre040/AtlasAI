    "query": "WITH both AS (\n  SELECT Gene,\n    TRY_CAST(\"Blood concentration - Conc. blood IM [pg/L]\" AS DOUBLE) im_c,\n    TRY_CAST(\"Blood concentration - Conc. blood MS [pg/L]\" AS DOUBLE) ms_c,\n    CASE WHEN \"Protein tissue specificity\"='Tissue enriched' AND \"Protein tissue specific Intensity\" LIKE 'liver:%'\n         THEN 'liver enriched' ELSE 'rest' END grp\n  FROM proteinatlas\n  WHERE \"Blood concentration - Conc. blood IM [pg/L]\" IS NOT NULL AND \"Blood concentration - Conc. blood IM [pg/L]\"<>''\n    AND \"Blood concentration - Conc. blood MS [pg/L]\" IS NOT NULL AND \"Blood concentration - Conc. blood MS [pg/L]\"<>''\n)\nSELECT grp, COUNT(*) n,\n  ROUND(MEDIAN(log10(ms_c)),4) med_log10_ms,\n  ROUND(MEDIAN(log10(im_c)),4) med_log10_im\nFROM both GROUP BY grp ORDER BY grp;"
