   "name": "sql",
   "input": {
    "query": "WITH base AS (\n  SELECT m.\"ENSG ID\" ens, p.Gene,\n    TRY_CAST(m.\"Conc [pg/L]\" AS DOUBLE) ms_c,\n    TRY_CAST(i.\"conc [pg/L]\" AS DOUBLE) ia_c,\n    i.\"sample type\" st, i.\"pubmed id\" pmid,\n    p.\"Protein tissue specificity\" p_ts,\n    p.\"Protein tissue specific Intensity\" p_ts_int\n  FROM proteinatlas p\n  JOIN blood_ms_concentration m USING(\"Ensembl\",\"ENSG ID\")\n  JOIN blood_immunoassay_concentration i USING(\"ENSG ID\")\n)\nSELECT COUNT(*) rows_, COUNT(DISTINCT ens) genes,\n SUM(CASE WHEN ms_c IS NULL THEN 1 ELSE 0 END) ms_null,\n SUM(CASE WHEN ia_c IS NULL THEN 1 ELSE 0 END) ia_null,\n SUM(CASE WHEN p_ts='Tissue enriched' THEN 1 ELSE 0 END) enr_rows\nFROM base;"
