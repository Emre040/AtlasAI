   "input": {
    "query": "WITH base AS (\n  SELECT p.\"Ensembl\" ens, p.Gene,\n    TRY_CAST(p.\"Blood concentration - Conc. blood IM [pg/L]\" AS DOUBLE) im_c,\n    TRY_CAST(m.\"Conc [pg/L]\" AS DOUBLE) ms_c,\n    CASE WHEN p.\"Protein tissue specificity\"='Tissue enriched' AND p.\"Protein tissue specific Intensity\" LIKE 'liver:%'\n         THEN 'liver' ELSE 'rest' END grp\n  FROM proteinatlas p\n  JOIN blood_ms_concentration m ON m.\"ENSG ID\"=p.\"Ensembl\"\n  JOIN blood_immunoassay_concentration i ON i.\"ENSG ID\"=p.\"Ensembl\"\n  GROUP BY 1,2,3,4,5\n),\nr AS (SELECT Gene, grp, ROUND(log10(im_c),2) l_im, ROUND(log10(ms_c),2) l_ms,\n      ROUND(log10(im_c)-log10(ms_c),3) ratio FROM base)\nSELECT grp, Gene, l_im, l_ms, ratio\nFROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY ratio DESC) rn FROM r) t\nWHERE rn<=10 ORDER BY grp, ratio DESC;"
