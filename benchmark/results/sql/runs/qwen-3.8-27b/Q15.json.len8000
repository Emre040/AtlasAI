    "query": "SELECT p.Gene, p.\"Ensembl\",\n  TRY_CAST(p.\"Blood concentration - Conc. blood IM [pg/L]\" AS DOUBLE) im_c,\n  TRY_CAST(m.\"Conc [pg/L]\" AS DOUBLE) ms_c,\n  ROUND(log10(TRY_CAST(p.\"Blood concentration - Conc. blood IM [pg/L]\" AS DOUBLE)),2) log_im,\n  ROUND(log10(TRY_CAST(m.\"Conc [pg/L]\" AS DOUBLE)),2) log_ms,\n  p.\"Protein tissue specific Intensity\"\nFROM proteinatlas p\nJOIN blood_ms_concentration m ON m.\"ENSG ID\"=p.\"Ensembl\"\nJOIN blood_immunoassay_concentration i ON i.\"ENSG ID\"=p.\"Ensembl\"\nWHERE p.\"Protein tissue specificity\"='Tissue enriched' AND p.\"Protein tissue specific Intensity\" LIKE 'liver:%'\nORDER BY 1;"
   },
