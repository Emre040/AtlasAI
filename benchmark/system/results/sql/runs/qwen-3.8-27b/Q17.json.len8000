     "name": "sql",
     "input": "{\"query\": \"WITH uni AS (SELECT Ensembl AS ens FROM proteinatlas WHERE \\\"RNA blood lineage specificity\\\"='Lineage enriched'),\\nm AS (SELECT r.Gene AS ens, r.\\\"Gene name\\\" AS sym,\\n    MAX(CASE WHEN r.\\\"Immune cell\\\"='NK-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END) AS nk,\\n    MAX(CASE WHEN r.\\\"Immune cell\\\"='naive B-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END) AS nb,\\n    MAX(CASE WHEN r.\\\"Immune cell\\\"='memory B-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END) AS mb,\\n    SUM(CASE WHEN r.\\\"Immune cell\\\"<>'NK-cell' AND TRY_CAST(r.nTPM AS DOUBLE)>=5 THEN 1 ELSE 0 END) AS nonNK,\\n    SUM(CASE WHEN r.\\\"Immune cell\\\" NOT IN ('naive B-cell','memory B-cell') AND TRY_CAST(r.nTPM AS DOUBLE)>=5 THEN 1 ELSE 0 END) AS nonB\\n  FROM rna_immune_cell r JOIN uni u ON u.ens=r.Gene WHERE r.\\\"Immune cell\\\"<>'total PBMC' GROUP BY r.Gene, r.\\\"Gene name\\\"),\\nf AS (SELECT *, (nk>=5 AND nonNK=0) AS nk_alone, ((nb>=5 OR mb>=5) AND nonB=0) AS b_alone FROM m)\\nSELECT 'NK' cohort, f.ens, f.sym, p.\\\"Gene description\\\" AS desc, f.nk, f.nb, f.mb\\nFROM f LEFT JOIN proteinatlas p ON p.Ensembl=f.ens\\nWHERE f.nk_alone\\nUNION ALL\\nSELECT 'B', f.ens, f.sym, p.\\\"Gene description\\\", f.nk, f.nb, f.mb\\nFROM f LEFT JOIN proteinatlas p ON p.Ensembl=f.ens\\nWHERE f.b_alone\\nORDER BY cohort, nk DESC, nb+mb DESC\"}"
