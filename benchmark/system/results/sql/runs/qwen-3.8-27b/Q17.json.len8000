     "name": "sql",
     "input": "{\"query\": \"WITH uni AS (\\n  SELECT Ensembl AS ens FROM proteinatlas WHERE \\\"RNA blood lineage specificity\\\"='Lineage enriched'\\n),\\nm AS (\\n  SELECT r.Gene AS ens, r.\\\"Immune cell\\\" AS cell, TRY_CAST(r.nTPM AS DOUBLE) AS ntpm\\n  FROM rna_immune_cell r JOIN uni u ON u.ens = r.Gene\\n  WHERE r.\\\"Immune cell\\\" <> 'total PBMC'\\n),\\np AS (\\n  SELECT ens,\\n    MAX(CASE WHEN cell='NK-cell' THEN ntpm END) AS nk,\\n    MAX(CASE WHEN cell='naive B-cell' THEN ntpm END) AS nb,\\n    MAX(CASE WHEN cell='memory B-cell' THEN ntpm END) AS mb,\\n    MAX(CASE WHEN cell='T-reg' THEN ntpm END) AS tr,\\n    SUM(CASE WHEN cell<>'NK-cell' AND ntpm>=5 THEN 1 ELSE 0 END) AS nonNK,\\n    SUM(CASE WHEN cell NOT IN ('naive B-cell','memory B-cell') AND ntpm>=5 THEN 1 ELSE 0 END) AS nonB\\n  FROM m GROUP BY ens\\n),\\nf AS (SELECT *, (nk>=5 AND nonNK=0) AS nk_alone, ((nb>=5 OR mb>=5) AND nonB=0) AS b_alone FROM p),\\nranked AS (\\n  SELECT f.*, COALESCE(pr.Gene, f.ens) AS sym,\\n    ROW_NUMBER() OVER (PARTITION BY 'NK' ORDER BY nk DESC, f.ens) AS rnk,\\n    ROW_NUMBER() OVER (PARTITION BY 'B' ORDER BY GREATEST(nb, mb) DESC, f.ens) AS rnb\\n  FROM f LEFT JOIN (SELECT Ensembl, Gene FROM proteinatlas WHERE Gene NOT LIKE 'ENSG%') pr ON pr.Ensembl=f.ens\\n  WHERE nk_alone OR b_alone\\n)\\nSELECT 'NK_cohort' AS cohort, ens, sym, nk, nb, mb, tr FROM ranked WHERE nk_alone AND rnk <= 12\\nUNION ALL\\nSELECT 'B_cohort', ens, sym, nk, nb, mb, tr FROM ranked WHERE b_alone AND rnb <= 12\\nORDER BY cohort, nk DESC\"}"
