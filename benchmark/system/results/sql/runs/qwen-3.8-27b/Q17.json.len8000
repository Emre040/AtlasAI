   "tool_uses": [
    {
     "name": "sql",
     "input": "{\"query\": \"WITH uni AS (\\n  SELECT Ensembl AS ens FROM proteinatlas WHERE \\\"RNA blood lineage specificity\\\"='Lineage enriched'\\n),\\nm AS (\\n  SELECT r.Gene AS ens, r.\\\"Immune cell\\\" AS cell, TRY_CAST(r.nTPM AS DOUBLE) AS ntpm\\n  FROM rna_immune_cell r JOIN uni u ON u.ens = r.Gene\\n  WHERE r.\\\"Immune cell\\\" <> 'total PBMC'\\n),\\np AS (\\n  SELECT ens,\\n    MAX(CASE WHEN cell='NK-cell' THEN ntpm END) AS nk,\\n    MAX(CASE WHEN cell='naive B-cell' THEN ntpm END) AS nb,\\n    MAX(CASE WHEN cell='memory B-cell' THEN ntpm END) AS mb,\\n    MAX(CASE WHEN cell='T-reg' THEN ntpm END) AS tr,\\n    SUM(CASE WHEN cell<>'NK-cell' AND ntpm>=5 THEN 1 ELSE 0 END) AS nonNK,\\n    SUM(CASE WHEN cell NOT IN ('naive B-cell','memory B-cell') AND ntpm>=5 THEN 1 ELSE 0 END) AS nonB\\n  FROM m GROUP BY ens\\n),\\nf AS (SELECT *, (nk>=5 AND nonNK=0) AS nk_alone, ((nb>=5 OR mb>=5) AND nonB=0) AS b_alone FROM p)\\nSELECT\\n  (SELECT COUNT(*) FROM f WHERE nk_alone) AS nk_cohort_size,\\n  (SELECT COUNT(*) FROM f WHERE b_alone) AS b_cohort_size,\\n  ROUND(AVG(ALL nk) FILTER (WHERE nk_alone)::DOUBLE,6) AS mean_nk_cohort,\\n  ROUND(AVG(ALL nb) FILTER (WHERE nk_alone)::DOUBLE,6) AS mean_naiveB_NK_cohort,\\n  ROUND(AVG(ALL mb) FILTER (WHERE nk_alone)::DOUBLE,6) AS mean_memB_NK_cohort,\\n  ROUND(AVG(ALL tr) FILTER (WHERE nk_alone)::DOUBLE,6) AS mean_Treg_NK_cohort,\\n  ROUND(AVG(ALL nk) FILTER (WHERE b_alone)::DOUBLE,6) AS mean_NK_B_cohort,\\n  ROUND(AVG(ALL nb) FILTER (WHERE b_alone)::DOUBLE,6) AS mean_naiveB_B_cohort,\\n  ROUND(AVG(ALL mb) FILTER (WHERE b_alone)::DOUBLE,6) AS mean_memB_B_cohort,\\n  ROUND(AVG(ALL tr) FILTER (WHERE b_alone)::DOUBLE,6) AS mean_Treg_B_cohort\\nFROM f\"}"
    },
    {
     "name": "sql",
     "input": "{\"query\": \"WITH uni AS (\\n  SELECT Ensembl AS ens FROM proteinatlas WHERE \\\"RNA blood lineage specificity\\\"='Lineage enriched'\\n)\\nSELECT u.ens, COALESCE(pr.\\\"Gene\\\", r.\\\"Gene name\\\") AS sym, u.\\\"RNA blood lineage specificity score\\\" AS score,\\n  TRY_CAST(CASE WHEN r.\\\"Immune cell\\\"='NK-cell' THEN r.nTPM END AS DOUBLE) AS nk,\\n  TRY_CAST(CASE WHEN r.\\\"Immune cell\\\"='naive B-cell' THEN r.nTPM END AS DOUBLE) AS nb,\\n  TRY_CAST(CASE WHEN r.\\\"Immune cell\\\"='memory B-cell' THEN r.nTPM END AS DOUBLE) AS mb,\\n  TRY_CAST(CASE WHEN r.\\\"Immune cell\\\"='T-reg' THEN r.nTPM END AS DOUBLE) AS tr,\\n  MAX(CASE WHEN r.\\\"Immune cell\\\"<>'NK-cell' AND TRY_CAST(r.nTPM AS DOUBLE)>=5 THEN 1 ELSE 0 END) OVER (PARTITION BY u.ens) AS nonNK,\\n  MAX(CASE WHEN r.\\\"Immune cell\\\" NOT IN ('naive B-cell','memory B-cell') AND TRY_CAST(r.nTPM AS DOUBLE)>=5 THEN 1 ELSE 0 END) OVER (PARTITION BY u.ens) AS nonB\\nFROM uni u\\nLEFT JOIN proteinatlas pr ON pr.Ensembl = u.ens\\nLEFT JOIN rna_immune_cell r ON r.Gene = u.ens AND r.\\\"Immune cell\\\" IN ('NK-cell','naive B-cell','memory B-cell','T-reg')\\nWHERE 1=2\"}"
    }
