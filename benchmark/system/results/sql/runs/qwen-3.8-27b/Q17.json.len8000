     "name": "sql",
     "input": "{\"query\": \"SELECT Gene, \\\"Gene description\\\" FROM proteinatlas WHERE Gene IN ('RAMP1','NCAM1','CYTL1','RAB38','COX6A2','NFILZ','LGALS9B','GNAI1','STYK1','TNFSF11','SERPINE1','PLK2','IGKV3-15','IGKV3-20','IGKV1D-39','IGHJ5','IGLV1-47','IGLV3-1','IGKV1-39','IGKV1-5','VPREB3','IGLV1-40','IGLV3-19','IGLV1-44') ORDER BY Gene\"}"
    },
    {
     "name": "sql",
     "input": "{\"query\": \"WITH uni AS (SELECT Ensembl AS ens FROM proteinatlas WHERE \\\"RNA blood lineage specificity\\\"='Lineage enriched'),\\nm AS (SELECT r.Gene AS ens, r.\\\"Gene name\\\" AS sym, r.\\\"Immune cell\\\" AS cell, TRY_CAST(r.nTPM AS DOUBLE) AS ntpm\\n      FROM rna_immune_cell r JOIN uni u ON u.ens=r.Gene WHERE r.\\\"Immune cell\\\"<>'total PBMC'),\\np AS (SELECT ens, MAX(sym) AS sym,\\n    MAX(CASE WHEN cell='NK-cell' THEN ntpm END) AS nk,\\n    MAX(CASE WHEN cell='naive B-cell' THEN ntpm END) AS nb,\\n    MAX(CASE WHEN cell='memory B-cell' THEN ntpm END) AS mb,\\n    SUM(CASE WHEN cell<>'NK-cell' AND ntpm>=5 THEN 1 ELSE 0 END) AS nonNK,\\n    SUM(CASE WHEN cell NOT IN ('naive B-cell','memory B-cell') AND ntpm>=5 THEN 1 ELSE 0 END) AS nonB\\n  FROM m GROUP BY ens),\\nf AS (SELECT *, (nk>=5 AND nonNK=0) AS nk_alone, ((nb>=5 OR mb>=5) AND nonB=0) AS b_alone FROM p)\\nSELECT 'NK_cohort_CD' AS grp, ens, sym FROM f WHERE nk_alone AND sym LIKE 'CD%'\\nUNION ALL\\nSELECT 'NK_cohort_CDsym' AS grp, ens, sym FROM f WHERE nk_alone AND (\\n  sym ~* '(^|[^A-Z0-9])CD[0-9]' OR sym IN ('NCAM1','CYTL1','HLA-C','KIR2DL4','CDHR1','CR2','CD200')) AND NOT (sym LIKE 'CD%')\\nUNION ALL\\nSELECT 'B_cohort_CD' AS grp, ens, sym FROM f WHERE b_alone AND sym LIKE 'CD%'\\nUNION ALL\\nSELECT 'NK_all' , ens, sym FROM f WHERE nk_alone\\nUNION ALL\\nSELECT 'B_all', ens, sym FROM f WHERE b_alone\\nORDER BY grp, sym\"}"
    }
   ]
