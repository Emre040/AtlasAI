    "query": "WITH g AS (\n  SELECT 'ENSG00000132329' ens UNION ALL SELECT 'ENSG00000149294' UNION ALL SELECT 'ENSG00000170891'\n  UNION ALL SELECT 'ENSG00000123892' UNION ALL SELECT 'ENSG00000156885' UNION ALL SELECT 'ENSG00000268480'\n  UNION ALL SELECT 'ENSG00000170298' UNION ALL SELECT 'ENSG00000127955' UNION ALL SELECT 'ENSG00000060140'\n  UNION ALL SELECT 'ENSG00000120659'\n  UNION ALL SELECT 'ENSG00000244437' UNION ALL SELECT 'ENSG00000239951' UNION ALL SELECT 'ENSG00000251546'\n  UNION ALL SELECT 'ENSG00000242472' UNION ALL SELECT 'ENSG00000211648' UNION ALL SELECT 'ENSG00000211673'\n  UNION ALL SELECT 'ENSG00000242371' UNION ALL SELECT 'ENSG00000243466' UNION ALL SELECT 'ENSG00000128218'\n  UNION ALL SELECT 'ENSG00000211653'\n),\npiv AS (\n  SELECT g.ens,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='NK-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v1,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='naive B-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v2,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='memory B-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v3,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='T-reg' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v4,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='gdT-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v5,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='MAIT T-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v6,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='naive CD4 T-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v7,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='memory CD4 T-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v8,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='naive CD8 T-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v9,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='memory CD8 T-cell' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v10,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='classical monocyte' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v11,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='intermediate monocyte' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v12,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='non-classical monocyte' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v13,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='neutrophil' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v14,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='eosinophil' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v15,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='basophil' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v16,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='myeloid DC' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v17,\n    COALESCE(MAX(CASE WHEN r.\"Immune cell\"='plasmacytoid DC' THEN TRY_CAST(r.nTPM AS DOUBLE) END),0) AS v18\n  FROM g JOIN rna_immune_cell r ON r.Gene=g.ens WHERE r.\"Immune cell\"<>'total PBMC'\n  GROUP BY g.ens\n)\nSELECT ens, v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12,v13,v14,v15,v16,v17,v18 FROM piv"
   },
